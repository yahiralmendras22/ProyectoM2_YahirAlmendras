NODE_ENV=development

# Opción 1: usar una URL de conexión completa (recomendado para producción/Railway)
DATABASE_URL=postgresql://user:password@host:5432/database

# Opción 2: variables sueltas (usadas si DATABASE_URL no está definida)
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MILLIS=30000
DB_CONNECTION_TIMEOUT_MILLIS=2000